'use client';

import { useEffect, useState } from 'react';
import Link from 'next/link';

export default function BlogPage() {
  const [featureAvailable, setFeatureAvailable] = useState<boolean | null>(null);

  useEffect(() => {
    fetch('/features')
      .then((res) => {
        if (res.ok && !res.redirected) {
          setFeatureAvailable(true);
        } else {
          setFeatureAvailable(false);
        }
      })
      .catch(() => setFeatureAvailable(false));
  }, []);

  return (
    <div className="container mx-auto py-10">
      <h1 className="text-3xl font-bold mb-6">Blog</h1>
      <p className="mb-8">Welcome to the blog. Here you&apos;ll find the latest posts.</p>

      <div>
        <h2 className="text-2xl font-semibold mb-4">Feature Page</h2>
        {featureAvailable === null ? (
          <p>Checking if feature page exists...</p>
        ) : featureAvailable ? (
          <Link href="/features" className="text-blue-600 underline">
            Visit the Feature Page
          </Link>
        ) : (
          <p>The feature page is not available yet. It&apos;s being built.</p>
        )}
      </div>
    </div>
  );
}